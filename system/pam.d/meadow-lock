#%PAM-1.0
# meadow-lock: managed by meadow-setup
# PAM service for the Meadow lock screen, generated from /etc/pam.d/sddm
# by `meadow-setup enable-fingerprint`. Removed by disable-fingerprint.
auth  [success=done default=ignore]  pam_fprintd.so max-tries=3 timeout=15
auth        substack      password-auth
auth        include       postlogin
account     required      pam_nologin.so
account     include       password-auth
