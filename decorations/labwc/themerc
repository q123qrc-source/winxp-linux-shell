# labwc decoration theme "Meadow-Luna". Values mirror theme/luna-blue/theme.json
# (window.*); phase 5 generates this file from the JSON and adds button SVGs.
border.width: 4
padding.height: 7
titlebar.height: 30

window.active.border.color: #0055EA
window.inactive.border.color: #7B97E0

window.active.title.bg: gradient vertical
window.active.title.bg.color: #0997FF
window.active.title.bg.colorTo: #003DD7
window.inactive.title.bg: gradient vertical
window.inactive.title.bg.color: #A6BCF5
window.inactive.title.bg.colorTo: #7591DA

window.active.label.text.color: #FFFFFF
window.inactive.label.text.color: #D8E4F8
window.label.text.justify: left

window.active.button.unpressed.image.color: #FFFFFF
window.inactive.button.unpressed.image.color: #FFFFFF
