#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_INSTALL_LIBEXECDIR=libexec \
		-DMEADOW_PAM_FLAVOUR=debian \
		-DMEADOW_BUILD_TESTS=ON \
		-DMEADOW_BUILD_GALLERY=OFF

# Screenshot and timing tests depend on fonts and machine speed.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	ctest --test-dir obj-$(DEB_HOST_GNU_TYPE) --output-on-failure --label-exclude 'screenshot|perf'
endif
