#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts a Meadow session: exports the desktop identity and toolkit theming,
# then hands over to labwc with Meadow's configuration directory.
#
# Configuration lookup: ~/.config/meadow/labwc (user copy) wins over the
# packaged defaults in $MEADOW_DATADIR/labwc.

MEADOW_DATADIR="${MEADOW_DATADIR:-/usr/share/meadow}"

# "X-Meadow" for OnlyShowIn= in .desktop files: desktop-file-validate accepts
# only registered names or X- extensions. "Meadow" stays first (portals.conf).
export XDG_CURRENT_DESKTOP=Meadow:X-Meadow
export XDG_SESSION_DESKTOP=meadow
export XDG_SESSION_TYPE=wayland
export DESKTOP_SESSION=meadow

export QT_QPA_PLATFORM="wayland;xcb"
# qt6ct is optional; Kvantum alone provides the widget style.
if [ -z "$QT_QPA_PLATFORMTHEME" ] && command -v qt6ct >/dev/null 2>&1; then
    export QT_QPA_PLATFORMTHEME=qt6ct
fi
export QT_STYLE_OVERRIDE=kvantum
export GTK_THEME=Meadow-Luna
export XCURSOR_THEME=meadow-cursors
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export MOZ_ENABLE_WAYLAND=1

# Keyboard layout: labwc reads XKB_DEFAULT_*, not the system setting, so take
# the X11 layout `localectl set-x11-keymap` stored, unless one is already set
# (e.g. in ~/.config/meadow/labwc/environment).
if [ -z "${XKB_DEFAULT_LAYOUT:-}" ] && [ -r /etc/X11/xorg.conf.d/00-keyboard.conf ]; then
    xkb_option() {
        sed -n "s/^[[:space:]]*Option[[:space:]]*\"$1\"[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
            /etc/X11/xorg.conf.d/00-keyboard.conf | head -n1
    }
    layout=$(xkb_option XkbLayout)
    if [ -n "$layout" ]; then
        export XKB_DEFAULT_LAYOUT="$layout"
        variant=$(xkb_option XkbVariant); [ -n "$variant" ] && export XKB_DEFAULT_VARIANT="$variant"
        options=$(xkb_option XkbOptions); [ -n "$options" ] && export XKB_DEFAULT_OPTIONS="$options"
    fi
fi

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/meadow/labwc"
[ -d "$config_dir" ] || config_dir="$MEADOW_DATADIR/labwc"

if ! command -v labwc >/dev/null 2>&1; then
    echo "meadow-session: labwc is not installed" >&2
    exit 1
fi

# Runtime overlay: labwc reads its config from a per-session directory of
# symlinks to the real files plus a writable environment.d/, where
# meadow-shell's language bar writes the keyboard layout order before asking
# labwc to reconfigure. Nothing under the user's or the packaged config dir
# is modified. Without XDG_RUNTIME_DIR the plain config dir is used.
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
    # Named after this PID, which labwc keeps after exec; overlays of
    # sessions that have ended are removed.
    for old in "$XDG_RUNTIME_DIR"/meadow/labwc-*; do
        [ -d "$old" ] || continue
        kill -0 "${old##*-}" 2>/dev/null || rm -rf "$old"
    done
    overlay="$XDG_RUNTIME_DIR/meadow/labwc-$$"
    if mkdir -p "$overlay/environment.d"; then
        for f in "$config_dir"/*; do
            [ -e "$f" ] || continue
            name=$(basename "$f")
            [ "$name" = environment.d ] && continue
            ln -sf "$f" "$overlay/$name"
        done
        # The user's own environment.d entries keep working.
        if [ -d "$config_dir/environment.d" ]; then
            for f in "$config_dir"/environment.d/*.env; do
                [ -e "$f" ] && ln -sf "$f" "$overlay/environment.d/$(basename "$f")"
            done
        fi
        export MEADOW_LABWC_ENV_FILE="$overlay/environment.d/90-meadow-keyboard.env"
        rm -f "$MEADOW_LABWC_ENV_FILE"
        # meadow-shell may replace overlay/rc.xml with an edited copy of the
        # real one (color scheme, mouse and keyboard settings).
        export MEADOW_LABWC_OVERLAY="$overlay" MEADOW_LABWC_SOURCE="$config_dir"
        config_dir="$overlay"
    fi
fi

exec labwc --config-dir "$config_dir" "$@"
