#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts a Meadow session: exports the desktop identity and toolkit theming,
# then hands over to labwc with Meadow's configuration directory.
#
# Configuration lookup: ~/.config/meadow/labwc (user copy) wins over the
# packaged defaults in $MEADOW_DATADIR/labwc.

# Data lives next to this script: <prefix>/bin/meadow-session ->
# <prefix>/share/meadow (install.sh may use /usr/local or another prefix).
if [ -z "${MEADOW_DATADIR:-}" ]; then
    self=$(readlink -f "$0" 2>/dev/null || echo "$0")
    meadow_prefix=$(cd "$(dirname "$self")/.." 2>/dev/null && pwd)
    if [ -n "$meadow_prefix" ] && [ -d "$meadow_prefix/share/meadow" ]; then
        MEADOW_DATADIR="$meadow_prefix/share/meadow"
    else
        MEADOW_DATADIR=/usr/share/meadow
    fi
fi
meadow_share=$(dirname "$MEADOW_DATADIR")
# A prefix other than /usr: make its themes, icons, cursors and sounds visible.
if [ "$meadow_share" != /usr/share ]; then
    case ":${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:" in
        *":$meadow_share:"*) ;;
        *) export XDG_DATA_DIRS="$meadow_share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" ;;
    esac
    export XCURSOR_PATH="$meadow_share/icons:${XCURSOR_PATH:-$HOME/.local/share/icons:$HOME/.icons:/usr/share/icons:/usr/share/pixmaps}"
fi

# "X-Meadow" for OnlyShowIn= in .desktop files: desktop-file-validate accepts
# only registered names or X- extensions. "Meadow" stays first (portals.conf).
export XDG_CURRENT_DESKTOP=Meadow:X-Meadow
export XDG_SESSION_DESKTOP=meadow
export XDG_SESSION_TYPE=wayland
export DESKTOP_SESSION=meadow

export QT_QPA_PLATFORM="wayland;xcb"
# qt6ct is optional; Kvantum alone provides the widget style.
if [ -z "$QT_QPA_PLATFORMTHEME" ] && command -v qt6ct >/dev/null 2>&1; then
    export QT_QPA_PLATFORMTHEME=qt6ct
fi
export QT_STYLE_OVERRIDE=kvantum
export GTK_THEME=Meadow-Luna
export XCURSOR_THEME=meadow-cursors
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export MOZ_ENABLE_WAYLAND=1

# Defaults for third-party applications, for this session only (nothing is
# written to ~ or /etc, and whatever the user set explicitly still wins):
#  - GTK/GNOME settings (icon, cursor, font and sound themes) from a read-only
#    dconf database layered under the user's own (DCONF_PROFILE);
#  - Kvantum's theme choice, PCManFM-Qt and GTK settings.ini defaults from
#    $MEADOW_DATADIR/xdg, after a per-session directory where meadow-shell
#    writes the color scheme's Kvantum theme (MEADOW_RUNTIME_XDG);
#  - the classic font-name aliases (FONTCONFIG_FILE loads the system
#    configuration plus Meadow's aliases).
# On exit they are removed from the user's systemd/D-Bus environment again.
if [ -z "${DCONF_PROFILE:-}" ] && [ -r "$MEADOW_DATADIR/dconf/profile" ]; then
    export DCONF_PROFILE="$MEADOW_DATADIR/dconf/profile"
fi
if [ -z "${FONTCONFIG_FILE:-}" ] && [ -r "$MEADOW_DATADIR/fontconfig/fonts.conf" ]; then
    export FONTCONFIG_FILE="$MEADOW_DATADIR/fontconfig/fonts.conf"
fi
config_dirs="${XDG_CONFIG_DIRS:-/etc/xdg}"
[ -d "$MEADOW_DATADIR/xdg" ] && config_dirs="$MEADOW_DATADIR/xdg:$config_dirs"
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
    export MEADOW_RUNTIME_XDG="$XDG_RUNTIME_DIR/meadow/xdg-$$"
    mkdir -p "$MEADOW_RUNTIME_XDG" && config_dirs="$MEADOW_RUNTIME_XDG:$config_dirs"
fi
export XDG_CONFIG_DIRS="$config_dirs"

# Keyboard layout: labwc reads XKB_DEFAULT_*, not the system setting, so take
# the X11 layout `localectl set-x11-keymap` stored, unless one is already set
# (e.g. in ~/.config/meadow/labwc/environment).
if [ -z "${XKB_DEFAULT_LAYOUT:-}" ] && [ -r /etc/X11/xorg.conf.d/00-keyboard.conf ]; then
    xkb_option() {
        sed -n "s/^[[:space:]]*Option[[:space:]]*\"$1\"[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
            /etc/X11/xorg.conf.d/00-keyboard.conf | head -n1
    }
    layout=$(xkb_option XkbLayout)
    if [ -n "$layout" ]; then
        export XKB_DEFAULT_LAYOUT="$layout"
        variant=$(xkb_option XkbVariant); [ -n "$variant" ] && export XKB_DEFAULT_VARIANT="$variant"
        options=$(xkb_option XkbOptions); [ -n "$options" ] && export XKB_DEFAULT_OPTIONS="$options"
    fi
fi

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/meadow/labwc"
[ -d "$config_dir" ] || config_dir="$MEADOW_DATADIR/labwc"

if ! command -v labwc >/dev/null 2>&1; then
    echo "meadow-session: labwc is not installed" >&2
    exit 1
fi

# Runtime overlay: labwc reads its config from a per-session directory of
# symlinks to the real files plus a writable environment.d/, where
# meadow-shell's language bar writes the keyboard layout order before asking
# labwc to reconfigure. Nothing under the user's or the packaged config dir
# is modified. Without XDG_RUNTIME_DIR the plain config dir is used.
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
    # Named after this script's PID, which lives as long as the session;
    # overlays of sessions that have ended are removed.
    for old in "$XDG_RUNTIME_DIR"/meadow/labwc-* "$XDG_RUNTIME_DIR"/meadow/xdg-*; do
        [ -d "$old" ] || continue
        kill -0 "${old##*-}" 2>/dev/null || rm -rf "$old"
    done
    overlay="$XDG_RUNTIME_DIR/meadow/labwc-$$"
    if mkdir -p "$overlay/environment.d"; then
        for f in "$config_dir"/*; do
            [ -e "$f" ] || continue
            name=$(basename "$f")
            [ "$name" = environment.d ] && continue
            ln -sf "$f" "$overlay/$name"
        done
        # The user's own environment.d entries keep working.
        if [ -d "$config_dir/environment.d" ]; then
            for f in "$config_dir"/environment.d/*.env; do
                [ -e "$f" ] && ln -sf "$f" "$overlay/environment.d/$(basename "$f")"
            done
        fi
        export MEADOW_LABWC_ENV_FILE="$overlay/environment.d/90-meadow-keyboard.env"
        rm -f "$MEADOW_LABWC_ENV_FILE"
        # meadow-shell may replace overlay/rc.xml with an edited copy of the
        # real one (color scheme, mouse and keyboard settings).
        export MEADOW_LABWC_OVERLAY="$overlay" MEADOW_LABWC_SOURCE="$config_dir"
        config_dir="$overlay"
    fi
fi

# labwc runs as a child (not exec) so the session can be cleaned up after it.
session_cleanup() {
    # The user's systemd/D-Bus activation environment outlives this session:
    # take Meadow's settings out again so a later GNOME or KDE session of the
    # same user does not inherit them, and stop the GTK portal backend, which
    # read Meadow's defaults when it started.
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user unset-environment DCONF_PROFILE FONTCONFIG_FILE XDG_CONFIG_DIRS MEADOW_RUNTIME_XDG \
            GTK_THEME QT_STYLE_OVERRIDE QT_QPA_PLATFORM XCURSOR_THEME XCURSOR_SIZE WAYLAND_DISPLAY DISPLAY \
            XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP >/dev/null 2>&1
        systemctl --user stop xdg-desktop-portal-gtk.service >/dev/null 2>&1
    fi
    [ -n "${MEADOW_RUNTIME_XDG:-}" ] && rm -rf "$MEADOW_RUNTIME_XDG"
    [ -n "${MEADOW_LABWC_OVERLAY:-}" ] && rm -rf "$MEADOW_LABWC_OVERLAY"
    # meadow-shell-supervise's single-instance lock; the directory itself goes
    # once nothing else of Meadow's is left in it (the lock flag may be).
    rm -f "${XDG_RUNTIME_DIR:-/nonexistent}/meadow/shell-supervise.lock"
    rmdir "${XDG_RUNTIME_DIR:-/nonexistent}/meadow" 2>/dev/null
}
labwc --config-dir "$config_dir" "$@" &
labwc_pid=$!
trap 'kill -TERM "$labwc_pid" 2>/dev/null' TERM INT HUP
status=0
while kill -0 "$labwc_pid" 2>/dev/null; do
    wait "$labwc_pid"
    status=$?
done
session_cleanup
exit "$status"
