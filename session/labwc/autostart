#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Run by labwc when the Meadow session starts.

# Let D-Bus-activated services (portals, polkit, notifications) and systemd
# user units see this session's display and theming.
dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
    XCURSOR_THEME XCURSOR_SIZE QT_QPA_PLATFORM QT_STYLE_OVERRIDE GTK_THEME \
    DCONF_PROFILE FONTCONFIG_FILE XDG_CONFIG_DIRS MEADOW_RUNTIME_XDG XDG_RUNTIME_DIR >/dev/null 2>&1 &

# MEADOW_NO_SHELL=1 starts a bare compositor (decoration tests, debugging).
[ "${MEADOW_NO_SHELL:-0}" = 1 ] && exit 0

# meadow-shell, restarted if it crashes (see meadow-shell-supervise).
meadow-shell-supervise &
