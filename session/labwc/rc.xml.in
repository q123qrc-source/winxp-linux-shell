<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     {{HEADER}}
     Template: session/labwc/rc.xml.in. labwc configuration for the Meadow
     session (labwc-config(5), labwc-actions(5)).
     To customize, copy /usr/share/meadow/labwc to ~/.config/meadow/labwc;
     meadow-session prefers that directory. -->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <reuseOutputMode>no</reuseOutputMode>
  </core>

  <theme>
    <name>{{THEME_NAME}}</name>
    <cornerRadius>{{CORNER_RADIUS}}</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>no</dropShadows>
    <titlebar>
      <!-- Window icon on the left; minimize, maximize, close on the right. -->
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place="ActiveWindow"><name>{{TITLE_FONT}}</name><size>{{TITLE_SIZE}}</size><weight>{{TITLE_WEIGHT}}</weight></font>
    <font place="InactiveWindow"><name>{{TITLE_FONT}}</name><size>{{TITLE_SIZE}}</size><weight>{{TITLE_WEIGHT}}</weight></font>
    <font place="MenuHeader"><name>{{UI_FONT}}</name><size>{{UI_SIZE}}</size><weight>bold</weight></font>
    <font place="MenuItem"><name>{{UI_FONT}}</name><size>{{UI_SIZE}}</size></font>
    <font place="OnScreenDisplay"><name>{{UI_FONT}}</name><size>{{UI_SIZE}}</size></font>
  </theme>

  <!-- Click to focus; clicking also raises. -->
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>

  <placement>
    <policy>automatic</policy>
  </placement>

  <windowSwitcher preview="no" outlines="yes">
    <osd show="yes" style="classic" output="focused" />
    <fields>
      <field content="icon" width="10%" />
      <field content="title" width="90%" />
    </fields>
  </windowSwitcher>

  <keyboard>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>

    <!-- Windows key alone: Start menu. Other Win+ combinations below. -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="meadow-shellctl toggle-start-menu" /></keybind>
    <keybind key="Super_R" onRelease="yes"><action name="Execute" command="meadow-shellctl toggle-start-menu" /></keybind>
    <keybind key="C-Escape"><action name="Execute" command="meadow-shellctl toggle-start-menu" /></keybind>
    <keybind key="W-d"><action name="Execute" command="meadow-shellctl show-desktop" /></keybind>
    <keybind key="W-e"><action name="Execute" command="pcmanfm-qt" /></keybind>
    <keybind key="W-r"><action name="Execute" command="meadow-shellctl run" /></keybind>
    <keybind key="W-l"><action name="Execute" command="meadow-shellctl lock" /></keybind>
    <keybind key="W-m"><action name="ForEach"><then><action name="Iconify" /></then></action></keybind>

    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="A-space"><action name="ShowMenu" menu="client-menu" atCursor="no" /></keybind>
    <keybind key="C-A-Delete"><action name="Execute" command="meadow-shellctl log-off" /></keybind>
    <!-- Alt+Shift (either order) cycles the language bar's layouts. -->
    <keybind key="A-Shift_L" onRelease="yes"><action name="Execute" command="meadow-shellctl next-layout" /></keybind>
    <keybind key="S-Alt_L" onRelease="yes"><action name="Execute" command="meadow-shellctl next-layout" /></keybind>

    <keybind key="W-Up"><action name="Maximize" /></keybind>
    <keybind key="W-Down"><action name="UnMaximize" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>

    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
  </keyboard>

  <mouse>
    <doubleClickTime>500</doubleClickTime>
    <default />
    <!-- Title bar: double-click maximizes (as before), right-click opens the window menu. -->
    <context name="Title">
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize" /></mousebind>
      <mousebind button="Right" action="Click"><action name="ShowMenu" menu="client-menu" /></mousebind>
    </context>
    <!-- The shell draws the desktop and its menu; labwc's root menu stays off. -->
    <context name="Root">
      <mousebind button="Left" action="Press"><action name="None" /></mousebind>
      <mousebind button="Right" action="Press"><action name="None" /></mousebind>
      <mousebind button="Middle" action="Press"><action name="None" /></mousebind>
    </context>
  </mouse>

</labwc_config>
