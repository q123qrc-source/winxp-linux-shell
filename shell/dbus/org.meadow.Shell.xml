<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     org.meadow.Shell: actions labwc keybinds (via meadow-shellctl) and other
     session components ask meadow-shell to perform. Session bus, object
     /org/meadow/Shell. -->
<node>
  <interface name="org.meadow.Shell">
    <!-- Open the Start menu, or close it if it is open (Windows key). -->
    <method name="ToggleStartMenu"/>
    <!-- Show the Run dialog (Win+R). -->
    <method name="ShowRunDialog"/>
    <!-- Minimize every window, or restore them if the desktop is shown (Win+D). -->
    <method name="ShowDesktop"/>
    <!-- Lock the session (Win+L). -->
    <method name="Lock"/>
    <!-- Log Off dialog: Switch User / Log Off (Ctrl+Alt+Delete). -->
    <method name="ShowLogOffDialog"/>
    <!-- Turn Off Computer dialog. -->
    <method name="ShowTurnOffDialog"/>
    <!-- Switch to the next keyboard layout in the language bar (Alt+Shift). -->
    <method name="NextKeyboardLayout"/>
    <!-- Alt+Tab switcher: direction 1 = next window, -1 = previous. -->
    <method name="SwitchWindow">
      <arg name="direction" type="i" direction="in"/>
    </method>
    <!-- Control Panel; page is "" (categories) or an applet name
         (display, sounds, mouse, keyboard, datetime, users, network). -->
    <method name="ShowControlPanel">
      <arg name="page" type="s" direction="in"/>
    </method>
    <!-- Display Properties at a tab (themes, desktop, screensaver,
         appearance, settings; "" for the first). -->
    <method name="ShowDisplayProperties">
      <arg name="tab" type="s" direction="in"/>
    </method>
    <!-- Whether the session is locked (tests, scripts). -->
    <method name="IsLocked">
      <arg name="locked" type="b" direction="out"/>
    </method>
    <!-- Emitted when the session is locked or unlocked. -->
    <signal name="LockedChanged">
      <arg name="locked" type="b"/>
    </signal>
    <!-- meadow-shell version; also a cheap liveness check. -->
    <method name="Version">
      <arg name="version" type="s" direction="out"/>
    </method>
  </interface>
</node>
