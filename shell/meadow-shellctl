#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# meadow-shellctl: ask the running meadow-shell to do something.
# Used by the Meadow labwc keybinds; talks to org.meadow.Shell on the session bus.
set -u

usage() {
    cat <<'USAGE'
Usage: meadow-shellctl COMMAND [ARG]

Commands:
  toggle-start-menu   Open or close the Start menu        (Windows key)
  run                 Show the Run dialog                  (Win+R)
  show-desktop        Minimize or restore all windows      (Win+D)
  lock                Lock the session                     (Win+L)
  log-off             Show the Log Off dialog              (Ctrl+Alt+Delete)
  turn-off            Show the Turn Off Computer dialog
  next-layout         Switch to the next keyboard layout   (Alt+Shift)
  switch-window next|prev
                      Window switcher                      (Alt+Tab, Alt+Shift+Tab)
  control-panel [PAGE]
                      Open Control Panel (pages: display, sounds, mouse,
                      keyboard, datetime, users, network)
  display-properties [TAB]
                      Open Display Properties (tabs: themes, desktop,
                      screensaver, appearance, settings)
  is-locked           Print "yes" if the session is locked, else "no"
  version             Print the running shell's version
USAGE
}

sig=""
arg=""
case "${1:-}" in
    toggle-start-menu) method=ToggleStartMenu ;;
    run)               method=ShowRunDialog ;;
    show-desktop)      method=ShowDesktop ;;
    lock)              method=Lock ;;
    log-off)           method=ShowLogOffDialog ;;
    turn-off)          method=ShowTurnOffDialog ;;
    next-layout)       method=NextKeyboardLayout ;;
    version)           method=Version ;;
    is-locked)         method=IsLocked ;;
    switch-window)
        method=SwitchWindow; sig=i
        case "${2:-next}" in
            next) arg=1 ;;
            prev|previous) arg=-1 ;;
            *) usage >&2; exit 2 ;;
        esac ;;
    control-panel)      method=ShowControlPanel; sig=s; arg="${2:-}" ;;
    display-properties) method=ShowDisplayProperties; sig=s; arg="${2:-}" ;;
    -h|--help|help)    usage; exit 0 ;;
    *)                 usage >&2; exit 2 ;;
esac

call() {
    if [ -n "$sig" ]; then
        busctl --user call org.meadow.Shell /org/meadow/Shell org.meadow.Shell "$method" "$sig" -- "$arg"
    else
        busctl --user call org.meadow.Shell /org/meadow/Shell org.meadow.Shell "$method"
    fi
}

if out=$(call 2>&1); then
    # busctl prints e.g. 's "0.1.0"' for a string result and 'b true' for a boolean.
    case "$method" in
        Version)  printf '%s\n' "$out" | sed -n 's/^s "\(.*\)"$/\1/p' ;;
        IsLocked) [ "$out" = "b true" ] && echo yes || echo no ;;
    esac
    exit 0
fi

# The shell is not running (or not answering).
if [ "$method" = Lock ] && command -v loginctl >/dev/null 2>&1; then
    # logind asks the session's screen locker; without meadow-shell there may be none.
    exec loginctl lock-session
fi
echo "meadow-shellctl: meadow-shell is not running ($out)" >&2
exit 1
