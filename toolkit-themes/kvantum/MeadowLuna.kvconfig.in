# SPDX-License-Identifier: GPL-3.0-or-later
# Meadow Luna Kvantum theme template. tools/gen-toolkit-themes.py expands it
# per scheme from theme.json and draws the matching SVG; edit the tokens.
[%General]
author=Meadow contributors
comment=Luna-style Qt theme for the Meadow desktop (generated from theme.json)
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
embedded_tabs=false
mirror_doc_tabs=false
group_toolbar_buttons=false
spread_progressbar=true
composite=true
menu_shadow_depth=@{n:toolkit.kvantum.menuShadowDepth}
tooltip_shadow_depth=@{n:toolkit.kvantum.tooltipShadowDepth}
spread_menuitems=false
scroll_width=@{n:controls.scrollBar.width}
scroll_arrows=true
scroll_min_extent=@{n:controls.scrollBar.minThumbLength}
transient_scrollbar=false
slider_width=@{n:controls.slider.trackWidth}
slider_handle_width=@{n:controls.slider.thumbWidth}
slider_handle_length=@{n:controls.slider.thumbLength}
check_size=@{n:controls.checkBox.size}
textless_progressbar=false
progressbar_thickness=@{n:controls.progressBar.height}
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=true
fill_rubberband=true
merge_menubar_with_toolbar=false
small_icon_size=@{n:toolkit.kvantum.smallIconSize}
large_icon_size=@{n:toolkit.kvantum.largeIconSize}
button_icon_size=@{n:toolkit.kvantum.smallIconSize}
toolbar_icon_size=@{n:toolkit.kvantum.toolbarIconSize}
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=false
square_combo_button=true
inline_spin_indicators=true
spin_button_width=@{n:controls.spinBox.buttonWidth}
layout_spacing=@{n:toolkit.kvantum.layoutSpacing}
layout_margin=@{n:toolkit.kvantum.layoutMargin}
tooltip_delay=@{n:controls.tooltip.delayMs}
submenu_delay=@{n:controls.menu.submenuDelayMs}
animate_states=false
no_inactiveness=false
respect_DE=true

[GeneralColors]
window.color=@{kc:colors.windowBackground}
base.color=@{kc:controls.list.background}
alt.base.color=@{kc:colors.windowBackground}
button.color=@{kc:colors.windowBackground}
light.color=@{kc:colors.white}
mid.light.color=@{kc:controls.tab.paneBackground}
dark.color=@{kc:controls.menu.borderColor}
mid.color=@{kc:toolkit.gtk.frameBorderColor}
highlight.color=@{kc:colors.selection}
inactive.highlight.color=@{kc:controls.list.inactiveSelectionColor}
text.color=@{kc:colors.windowText}
window.text.color=@{kc:colors.windowText}
button.text.color=@{kc:controls.button.textColor}
disabled.text.color=@{kc:colors.disabledText}
tooltip.base.color=@{kc:controls.tooltip.background}
tooltip.text.color=@{kc:controls.tooltip.textColor}
highlight.text.color=@{kc:colors.selectionText}
link.color=@{kc:toolkit.linkColor}
link.visited.color=@{kc:toolkit.visitedLinkColor}
progress.indicator.text.color=@{kc:colors.windowText}

[Hacks]
respect_darkness=false
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
transparent_arrow_button=false
no_selection_tint=true
transparent_menutitle=true
single_top_toolbar=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=@{n:toolkit.kvantum.frameWidth}
frame.bottom=@{n:toolkit.kvantum.frameWidth}
frame.left=@{n:toolkit.kvantum.frameWidth}
frame.right=@{n:toolkit.kvantum.frameWidth}
interior=true
interior.element=button
indicator.size=@{n:controls.menu.glyphSize}
indicator.element=arrow
text.normal.color=@{kc:controls.button.textColor}
text.focus.color=@{kc:controls.button.textColor}
text.press.color=@{kc:controls.button.textColor}
text.toggle.color=@{kc:controls.button.textColor}
text.shadow=0
text.margin=1
text.iconspacing=@{n:toolkit.gtk.spacingMedium}
text.margin.top=@{n:toolkit.gtk.buttonPaddingV}
text.margin.bottom=@{n:toolkit.gtk.buttonPaddingV}
text.margin.left=@{n:controls.button.paddingH}
text.margin.right=@{n:controls.button.paddingH}
min_width=@{n:controls.button.minWidth}
min_height=@{n:controls.button.height}

[PanelButtonTool]
inherits=PanelButtonCommand

[ToolbarButton]
inherits=PanelButtonCommand
min_width=0

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
min_width=0
frame.element=spin
interior.element=spin
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=arrow
indicator.size=@{n:controls.menu.glyphSize}

[RadioButton]
inherits=PanelButtonCommand
min_width=0
frame=false
interior.element=radio
text.margin.left=@{n:controls.radio.spacing}

[CheckBox]
inherits=PanelButtonCommand
min_width=0
frame=false
interior.element=checkbox
text.margin.left=@{n:controls.checkBox.spacing}

[Focus]
inherits=PanelButtonCommand
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=false

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=@{n:controls.textField.padding}
text.margin.right=@{n:controls.textField.padding}
text.margin.top=0
text.margin.bottom=0

[ToolbarLineEdit]
inherits=LineEdit

[DropDownButton]
inherits=PanelButtonCommand
frame.element=dropdown
interior.element=dropdown
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=arrow-down
min_width=0

[IndicatorArrow]
indicator.element=arrow
indicator.size=@{n:controls.menu.glyphSize}

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
min_width=0
frame.element=tab
interior.element=tab
frame.top=@{n:toolkit.kvantum.frameWidth}
frame.bottom=0
frame.left=@{n:toolkit.kvantum.frameWidth}
frame.right=@{n:toolkit.kvantum.frameWidth}
text.margin.left=@{n:controls.tab.paddingH}
text.margin.right=@{n:controls.tab.paddingH}
text.margin.top=@{n:toolkit.gtk.spacingSmall}
text.margin.bottom=@{n:toolkit.gtk.spacingSmall}
indicator.element=tab
indicator.size=@{n:controls.menu.glyphSize}
focusFrame=false
min_height=@{n:controls.tab.height}

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
interior=true
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[TabBarFrame]
inherits=GenericFrame
frame=false

[TreeExpander]
inherits=PanelButtonCommand
min_width=0
frame=false
interior=false
indicator.size=@{n:toolkit.gtk.spacingLarge}
indicator.element=tree

[HeaderSection]
inherits=PanelButtonCommand
min_width=0
frame.element=header
interior.element=header
frame.top=@{n:toolkit.kvantum.frameWidth}
frame.bottom=@{n:toolkit.kvantum.frameWidth}
frame.left=@{n:toolkit.kvantum.frameWidth}
frame.right=@{n:toolkit.kvantum.frameWidth}
text.margin.top=0
text.margin.bottom=0
min_height=@{n:controls.menu.itemHeight}

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
text.margin=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin=0
text.bold=false
text.normal.color=@{kc:colors.windowText}

[ProgressbarContents]
inherits=PanelButtonCommand
frame=false
interior.element=progress-pattern
interior.x.patternsize=@{n:derived.progressBlockPeriod}

[ItemView]
inherits=PanelButtonCommand
min_width=0
frame.element=itemview
interior.element=itemview
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=0
text.margin.bottom=0
text.margin.left=@{n:controls.list.textPadding}
text.margin.right=@{n:controls.list.textPadding}
text.normal.color=@{kc:colors.windowText}
text.focus.color=@{kc:colors.windowText}
text.press.color=@{kc:controls.list.selectionTextColor}
text.toggle.color=@{kc:controls.list.selectionTextColor}

[Splitter]
indicator.size=@{n:toolkit.gtk.spacingMedium}

[Scrollbar]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
indicator.element=arrow
indicator.size=@{n:controls.menu.glyphSize}

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
indicator.element=grip
indicator.size=@{n:controls.scrollBar.gripLength}

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=scrollbargroove

[MenuItem]
inherits=PanelButtonCommand
min_width=0
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=arrow
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=@{n:controls.menu.paddingY}
text.margin.bottom=@{n:controls.menu.paddingY}
text.margin.left=@{n:toolkit.gtk.spacingMedium}
text.margin.right=@{n:controls.menu.paddingX}
text.normal.color=@{kc:colors.windowText}
text.focus.color=@{kc:controls.menu.hoverText}
min_height=@{n:controls.menu.itemHeight}

[MenuBar]
inherits=PanelButtonCommand
frame.element=menubar
interior.element=menubar
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[MenuBarItem]
inherits=PanelButtonCommand
min_width=0
interior=true
interior.element=menubaritem
frame.element=menubaritem
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.left=@{n:toolkit.gtk.spacingLarge}
text.margin.right=@{n:toolkit.gtk.spacingLarge}
text.normal.color=@{kc:colors.windowText}
text.focus.color=@{kc:controls.menu.hoverText}
text.press.color=@{kc:controls.menu.hoverText}
text.toggle.color=@{kc:controls.menu.hoverText}

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[ComboBox]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=@{n:controls.textField.padding}

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=@{kc:colors.windowText}

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
frame.top=@{n:toolkit.kvantum.frameWidth}
frame.bottom=@{n:toolkit.kvantum.frameWidth}
frame.left=@{n:toolkit.kvantum.frameWidth}
frame.right=@{n:toolkit.kvantum.frameWidth}
text.normal.color=@{kc:controls.groupBox.titleColor}
text.focus.color=@{kc:controls.groupBox.titleColor}
text.press.color=@{kc:controls.groupBox.titleColor}
text.bold=false

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior.element=tooltip
interior=true
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=@{n:controls.tooltip.padding}
text.margin.bottom=@{n:controls.tooltip.padding}
text.margin.left=@{n:controls.tooltip.padding}
text.margin.right=@{n:controls.tooltip.padding}
text.normal.color=@{kc:controls.tooltip.textColor}

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
frame=false

[Dialog]
inherits=Window
