[Icon Theme]
Name=Meadow Icons
Comment=Original glossy icons for the Meadow desktop (generated by tools/gen-icons.py)
Inherits=Adwaita,hicolor
Example=folder
Directories=16x16/apps,16x16/actions,16x16/categories,16x16/devices,16x16/mimetypes,16x16/places,16x16/status,scalable/apps,scalable/actions,scalable/categories,scalable/devices,scalable/mimetypes,scalable/places,scalable/status

[16x16/apps]
Size=16
Type=Fixed
Context=Applications

[16x16/actions]
Size=16
Type=Fixed
Context=Actions

[16x16/categories]
Size=16
Type=Fixed
Context=Categories

[16x16/devices]
Size=16
